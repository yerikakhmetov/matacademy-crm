# ── База данных (PostgreSQL) ──────────────────────────────
# Локально (Docker): postgresql://postgres:postgres@localhost:5434/matacademy?schema=public
# Облако (Neon): используйте POOLED-строку для DATABASE_URL и DIRECT-строку для DIRECT_URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/matacademy?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5434/matacademy?schema=public"

# ── Авторизация (Auth.js) ─────────────────────────────────
# Сгенерировать: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_TRUST_HOST=true

# ── Telegram-напоминания (необязательно) ──────────────────
# Токен бота от @BotFather и его username (без @)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Chat id администратора/группы для ежедневной сводки (узнать через @userinfobot)
TELEGRAM_ADMIN_CHAT_ID=""
# Секрет для вебхука Telegram (любая случайная строка)
TELEGRAM_WEBHOOK_SECRET=""
# Секрет для защиты cron-эндпоинта (openssl rand -hex 16)
CRON_SECRET=""

# ── WhatsApp (Meta Cloud API, необязательно) ──────────────
# Постоянный access token и Phone Number ID из Meta for Developers
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
# Имя и язык одобренного шаблона (по умолчанию payment_reminder / ru)
WHATSAPP_TEMPLATE="payment_reminder"
WHATSAPP_TEMPLATE_LANG="ru"
