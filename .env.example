# ── База данных (PostgreSQL) ──────────────────────────────
# Локально (Docker): postgresql://postgres:postgres@localhost:5434/matacademy?schema=public
# Облако (Neon): используйте POOLED-строку для DATABASE_URL и DIRECT-строку для DIRECT_URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/matacademy?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5434/matacademy?schema=public"

# ── Авторизация (Auth.js) ─────────────────────────────────
# Сгенерировать: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_TRUST_HOST=true
