// МатАкадемия CRM — схема базы данных
// PostgreSQL — единая СУБД для локальной разработки и облака (Neon/Vercel).
// DATABASE_URL — рабочее подключение (в облаке — пул PgBouncer).
// DIRECT_URL — прямое подключение для миграций (в облаке; локально совпадает с DATABASE_URL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Пользователи системы (вход + роли)
model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           String   @default("MANAGER") // ADMIN | MANAGER | TEACHER | STUDENT
  telegramUserId String?  @unique // id пользователя Telegram (для входа через Telegram)
  teacher        Teacher?
  student        Student?
  createdAt      DateTime @default(now())
}

// Преподаватели
model Teacher {
  id        String   @id @default(cuid())
  name      String
  specialty String
  phone     String?
  color     String   @default("#3A5AE0")
  photoUrl  String? // фото профиля (Vercel Blob)
  rate      Int      @default(0) // ставка (тг за урок/ученика или % — по rateType)
  rateType  String   @default("PER_LESSON") // PER_LESSON | PER_STUDENT | PERCENT
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  groups    Group[]
  subjects  Subject[] // какие предметы ведёт (many-to-many)
  payrollRecords PayrollRecord[]
  createdAt DateTime @default(now())
}

// Зафиксированная зарплата за месяц (снимок расчёта, чтобы прошлые месяцы не «плыли»)
model PayrollRecord {
  id        String   @id @default(cuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  year      Int
  month     Int // 0-based
  rate      Int
  rateType  String
  base      Int
  salary    Int
  createdBy String?
  createdAt DateTime @default(now())

  @@unique([teacherId, year, month])
  @@index([year, month])
}

// Учебные материалы (файлы)
model Material {
  id        String   @id @default(cuid())
  groupId   String? // null = для всех групп
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title     String
  fileUrl   String
  fileName  String
  fileType  String   @default("")
  uploadedBy String?
  createdAt DateTime @default(now())

  @@index([groupId])
}

// Учебные группы
model Group {
  id        String    @id @default(cuid())
  name      String
  level     String    @default("")
  capacity  Int       @default(12)
  color     String    @default("#3A5AE0")
  teacherId String?
  teacher   Teacher?  @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  subjectId String?
  subject   Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  students  Student[]
  lessons   Lesson[]
  homeworks Homework[]
  materials Material[]
  tests     Test[]
  createdAt DateTime  @default(now())
}

// Ученики
model Student {
  id            String         @id @default(cuid())
  name          String
  phone         String?
  grade         String?
  parentName    String?
  parentPhone   String?
  status         String        @default("ACTIVE") // ACTIVE | PAUSED | LEFT
  balance        Int           @default(0) // < 0 — задолженность (в тенге)
  personalDiscount Int         @default(0) // персональная скидка ученика, % (0 = нет)
  attendance     Int?          // % посещаемости; null = отметок ещё нет
  telegramChatId String? // chat id родителя в Telegram (для авто-напоминаний)
  portalToken    String? @unique // постоянный токен родительской страницы
  photoUrl       String? // фото ученика (Vercel Blob)
  userId         String? @unique // аккаунт ученика для входа в кабинет (вход через Telegram)
  user           User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  groups        Group[] // ученик может заниматься в нескольких группах (по предметам)
  payments          Payment[]
  subscriptions     Subscription[]
  attendanceRecords Attendance[]
  grades            Grade[]
  homeworkDone      HomeworkDone[]
  createdAt         DateTime       @default(now())
}

// Домашние задания (на группу)
model Homework {
  id          String         @id @default(cuid())
  groupId     String
  group       Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  createdBy   String?
  createdAt   DateTime       @default(now())
  completions HomeworkDone[]

  @@index([groupId])
}

// Отметка выполнения ДЗ учеником
model HomeworkDone {
  id         String   @id @default(cuid())
  homeworkId String
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  done       Boolean  @default(true)

  @@unique([homeworkId, studentId])
}

// Оценки успеваемости
model Grade {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  topic     String // за что (например «Контрольная: дроби»)
  type      String   @default("TEST") // TEST | HOMEWORK | QUIZ | EXAM
  score     Int
  maxScore  Int      @default(100)
  comment   String?
  createdBy String? // имя выставившего
  testId    String? // если оценка получена за тест
  test      Test?    @relation(fields: [testId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([testId, studentId])
  @@index([studentId])
}

// Тест/контрольная — содержит вопросы и/или используется для ввода оценок группы
model Test {
  id        String         @id @default(cuid())
  title     String
  groupId   String? // если привязан к группе (для ввода оценок)
  group     Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subjectId String? // предмет теста
  subject   Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  date      DateTime       @default(now())
  maxScore  Int            @default(100)
  createdBy String?
  createdAt DateTime       @default(now())
  grades    Grade[]
  questions TestQuestion[]

  @@index([groupId])
  @@index([subjectId])
}

// Вопрос теста с вариантами ответов и правильным вариантом
model TestQuestion {
  id      String   @id @default(cuid())
  testId  String
  test    Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  order   Int      @default(0)
  text    String
  options String[] // варианты ответов
  correct Int      @default(0) // индекс правильного варианта (0-based)

  @@index([testId])
}

// Предметы (математика, физика ...) — базовая цена и доля в комбо-абонементе
model Subject {
  id        String             @id @default(cuid())
  name      String
  price     Int                @default(0) // базовая цена за месяц
  color     String             @default("#3A5AE0")
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  items     SubscriptionItem[]
  payItems  PaymentItem[]
  groups    Group[]
  teachers  Teacher[] // преподаватели этого предмета (many-to-many)
  tests     Test[]
}

// Абонементы
model Subscription {
  id           String             @id @default(cuid())
  studentId    String
  student      Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plan         String
  months       Int                @default(1)
  price        Int                @default(0) // итоговая цена после скидок (за весь срок)
  basePrice    Int                @default(0) // сумма базовых цен предметов до скидок
  discountName String? // название применённой спец-скидки
  discountPct  Int                @default(0) // спец-скидка, %
  multiPct     Int                @default(0) // скидка за несколько предметов, %
  promoCode    String? // применённый промокод (если был)
  startDate    DateTime           @default(now())
  endDate      DateTime?
  status       String             @default("ACTIVE")
  items        SubscriptionItem[]
}

// Промокод: разовая процентная скидка, применяется при оформлении абонемента
model PromoCode {
  id        String   @id @default(cuid())
  code      String   @unique
  percent   Int      @default(0) // размер скидки, %
  active    Boolean  @default(true)
  maxUses   Int      @default(0) // 0 = без ограничения
  usedCount Int      @default(0) // сколько раз применён
  note      String? // комментарий (напр. «реферал Ивановых»)
  createdAt DateTime @default(now())
}

// Позиция абонемента по предмету (доля предмета)
model SubscriptionItem {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subjectId      String?
  subject        Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectName    String // снимок названия на момент продажи
  base           Int          @default(0) // базовая доля до скидок (за весь срок)
  amount         Int          @default(0) // итог после скидок — доля предмета

  @@index([subscriptionId])
  @@index([subjectId])
}

// Расписание — слот занятия для группы
model Lesson {
  id         String       @id @default(cuid())
  groupId    String
  group      Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 1 = Пн ... 6 = Сб
  startTime  String // "16:00"
  room       String       @default("Каб. 1")
  attendance Attendance[]
}

// Посещаемость — отметка ученика на конкретную дату занятия
model Attendance {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime // дата конкретного занятия
  present   Boolean  @default(true)

  @@unique([lessonId, studentId, date])
}

// Лиды / воронка продаж
model Lead {
  id         String         @id @default(cuid())
  name       String // контакт (родитель)
  childName  String?
  phone      String?
  grade      String?
  subject    String?
  source     String? // Instagram, 2ГИС, Сайт, Рекомендация...
  stage      String         @default("NEW") // NEW | CONTACTED | TRIAL | INVOICED | WON | LOST
  note       String?
  trialDate    DateTime? // запланированный пробный урок
  nextActionAt DateTime? // дата следующего действия (перезвонить и т.п.)
  activities LeadActivity[]
  createdAt  DateTime       @default(now())
}

// Активности по лиду: звонок, задача, заметка
model LeadActivity {
  id        String    @id @default(cuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String    @default("NOTE") // CALL | TASK | NOTE
  text      String
  dueDate   DateTime?
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())
}

// Одноразовый токен для входа через бота Telegram
model LoginToken {
  token     String   @id
  userId    String? // заполняется вебхуком, когда привязанный преподаватель нажал «Старт»
  createdAt DateTime @default(now())
}

// Настройки школы (единственная запись с id = "main")
model Settings {
  id         String   @id @default("main")
  schoolName String   @default("МатАкадемия")
  address    String   @default("г. Алматы, ул. Абая")
  branches   String   @default("Абая") // через запятую
  rooms      String   @default("Каб. 1, Каб. 2, Каб. 3") // через запятую
  tariffs    String   @default("[]") // JSON: [{plan, months, price}]
  tplOverdue String   @default("") // шаблон: долг
  tplPending String   @default("") // шаблон: ожидает оплаты
  tplExpiring String  @default("") // шаблон: абонемент истекает
  managerDenied String @default("") // запрещённые менеджеру модули (ключи через запятую)
  discounts     String @default("") // спец-скидки: "название | процент" построчно
  multiDiscount String @default("") // скидки за несколько предметов: "кол-во | процент" построчно
  discountMode  String @default("add") // как объединять скидки: add | max | mul
  siblingDiscount Int  @default(0) // скидка «брат/сестра», % (0 = выкл)
  updatedAt  DateTime @updatedAt
}

// Журнал изменений (аудит)
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String
  action    String // CREATE | UPDATE | DELETE
  entity    String // Ученик, Оплата, Лид, Группа, Абонемент, Занятие, Посещаемость
  label     String // имя/описание объекта
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Оплаты
model Payment {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  purpose   String
  method    String?  // Kaspi, Халық банк, Карта, Наличные
  amount    Int
  status    String   @default("PAID") // PAID | PENDING | OVERDUE
  date      DateTime @default(now())
  items     PaymentItem[]
}

// Разбивка платежа по предметам (пропорционально) — фактически собранный доход по предметам
model PaymentItem {
  id          String   @id @default(cuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectName String // снимок названия
  amount      Int      @default(0)

  @@index([paymentId])
  @@index([subjectId])
}
