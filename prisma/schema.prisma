// МатАкадемия CRM — схема базы данных
// PostgreSQL — единая СУБД для локальной разработки и облака (Neon/Vercel).
// DATABASE_URL — рабочее подключение (в облаке — пул PgBouncer).
// DIRECT_URL — прямое подключение для миграций (в облаке; локально совпадает с DATABASE_URL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Пользователи системы (вход + роли)
model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           String   @default("MANAGER") // ADMIN | MANAGER | CURATOR | TEACHER | STUDENT
  telegramUserId String?  @unique // id пользователя Telegram (для входа через Telegram)
  // Одноразовый код привязки Telegram к учётной записи. В ссылке случайный код,
  // а не id пользователя: утёкшая ссылка с id — это захват аккаунта.
  tgBindToken    String?   @unique
  tgBindIssued   DateTime?
  teacher        Teacher?
  student        Student?
  curatedGroups  Group[]  @relation("GroupCurator")
  createdAt      DateTime @default(now())
}

// Преподаватели
model Teacher {
  id        String   @id @default(cuid())
  name      String
  specialty String
  phone     String?
  color     String   @default("#3A5AE0")
  photoUrl  String? // фото профиля (Vercel Blob)
  rate      Int      @default(0) // УСТАРЕЛО: зарплата считается по посещаемости (lib/payroll-calc.ts)
  rateType  String   @default("PER_LESSON") // УСТАРЕЛО: оставлено, чтобы не терять историю; нигде не читается
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  groups    Group[]
  subjects  Subject[] // какие предметы ведёт (many-to-many)
  payrollRecords PayrollRecord[]
  createdAt DateTime @default(now())
}

// Зафиксированная зарплата за месяц (снимок расчёта, чтобы прошлые месяцы не «плыли»)
model PayrollRecord {
  id        String   @id @default(cuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  year      Int
  month     Int // 0-based
  rate      Int
  rateType  String
  base      Int
  salary    Int
  createdBy String?
  createdAt DateTime @default(now())

  @@unique([teacherId, year, month])
  @@index([year, month])
}

// Учебные материалы (файлы)
model Material {
  id        String   @id @default(cuid())
  groupId   String? // null = для всех групп
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title     String
  fileUrl   String
  fileName  String
  fileType  String   @default("")
  uploadedBy String?
  createdAt DateTime @default(now())
  // Материал конкретного занятия («что проходили»). null = материал группы вообще.
  lessonSessionId String?
  lessonSession   LessonSession? @relation(fields: [lessonSessionId], references: [id], onDelete: SetNull)

  @@index([groupId])
  @@index([lessonSessionId])
}

// Учебные группы
model Group {
  id        String    @id @default(cuid())
  name      String
  level     String    @default("")
  capacity  Int       @default(12)
  color     String    @default("#3A5AE0")
  // С какой даты группа начинает заниматься. До неё занятий по расписанию нет:
  // они не идут в журнал, в календарь и в делитель зарплаты. null = давно идёт.
  startDate DateTime?
  teacherId String?
  teacher   Teacher?  @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  // Куратор группы: следит за посещаемостью и журналом, но не ведёт занятия.
  curatorId String?
  curator   User?     @relation("GroupCurator", fields: [curatorId], references: [id], onDelete: SetNull)
  // Сколько куратор получает в месяц с каждого оплатившего ученика ЭТОЙ группы, ₸.
  // 0 = ставка предмета, а если и её нет — общая из настроек.
  curatorRate Int     @default(0)
  subjectId String?
  subject   Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  students  Student[]
  lessons   Lesson[]
  homeworks Homework[]
  materials Material[]
  grades    Grade[]
  tests       Test[]
  testLinks   TestGroup[]
  zachets     Zachet[]
  createdAt DateTime  @default(now())
}

// Ученики
model Student {
  id            String         @id @default(cuid())
  name          String
  phone         String?
  grade         String?
  parentName    String?
  parentPhone   String?
  status         String        @default("ACTIVE") // ACTIVE | PAUSED | LEFT
  balance        Int           @default(0) // < 0 — задолженность (в тенге)
  personalDiscount Int         @default(0) // персональная скидка ученика, % (0 = нет)
  careerTestUrl  String?       // личная ссылка на профориентационный тест (MentorHub)
  attendance     Int?          // % посещаемости; null = отметок ещё нет
  telegramChatId String? // chat id родителя в Telegram (для авто-напоминаний)
  portalToken    String? @unique // постоянный токен родительской страницы
  joinToken      String? @unique // токен ссылки-приглашения в кабинет (можно перевыпустить)
  joinTgId       String? // Telegram id, закрепивший кабинет за собой (защита от чужого входа)
  photoUrl       String? // фото ученика (Vercel Blob)
  parentPhotoUrl String? // фото родителя: показывается в его портале и в карточке ученика
  userId         String? @unique // аккаунт ученика для входа в кабинет (вход через Telegram)
  user           User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  groups        Group[] // ученик может заниматься в нескольких группах (по предметам)
  payments          Payment[]
  subscriptions     Subscription[]
  attendanceRecords Attendance[]
  grades            Grade[]
  homeworkDone      HomeworkDone[]
  testAttempts      TestAttempt[]
  makeups           Makeup[]
  zachetResults     ZachetResult[]
  createdAt         DateTime       @default(now())
}

// Домашние задания (на группу)
model Homework {
  id          String         @id @default(cuid())
  groupId     String
  group       Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  createdBy   String?
  createdAt   DateTime       @default(now())
  completions HomeworkDone[]

  @@index([groupId])
}

// Отметка выполнения ДЗ учеником
model HomeworkDone {
  id         String   @id @default(cuid())
  homeworkId String
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  done       Boolean  @default(true)
  fileUrl    String? // прикреплённая работа (Vercel Blob)
  fileName   String?
  comment    String? // короткая записка ученика к работе
  submittedAt DateTime? // когда прикрепил файл

  @@unique([homeworkId, studentId])
}

// Оценки успеваемости
model Grade {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  topic     String // за что (например «Контрольная: дроби»)
  type      String   @default("TEST") // TEST | HOMEWORK | QUIZ | EXAM
  score     Int
  maxScore  Int      @default(100)
  comment   String?
  createdBy String? // имя выставившего
  testId    String? // если оценка получена за тест
  test      Test?    @relation(fields: [testId], references: [id], onDelete: Cascade)
  // За какую группу выставлена. Ученик может заниматься в нескольких группах,
  // и без этой привязки его оценки показывались в каждой из них.
  groupId   String?
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([testId, studentId])
  @@index([studentId])
  @@index([groupId])
}

// Тест/контрольная — содержит вопросы и/или используется для ввода оценок группы
model Test {
  id        String         @id @default(cuid())
  title     String
  groupId   String? // основная группа (оценки выставляются по ней)
  group     Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // Один тест можно дать нескольким группам, у каждой — свой день теста
  // и своё расписание. Основная группа тоже входит в этот список.
  groupLinks TestGroup[]
  subjectId String? // предмет теста
  subject   Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  date      DateTime       @default(now())
  maxScore  Int            @default(100)
  shuffle   Boolean        @default(false) // перемешивать порядок вопросов для каждого ученика
  allowRetake Boolean      @default(false) // можно пройти заново (иначе одна попытка)
  timeLimitMin Int? // ограничение по времени, мин (пусто = без ограничения)
  // Момент, с которого тест открыт ученикам, выставленный вручную.
  // Пусто — открывается по расписанию (после урока в день теста).
  availableFrom DateTime?
  createdBy String?
  createdAt DateTime       @default(now())
  grades    Grade[]
  questions TestQuestion[]
  attempts  TestAttempt[]

  @@index([groupId])
  @@index([subjectId])
}

// Прохождение теста учеником (одна попытка): ответы, результат
model TestAttempt {
  id           String   @id @default(cuid())
  testId       String
  test         Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers      Int[] // выбранный вариант по каждому вопросу (в порядке order); -1 = без ответа
  correctCount Int      @default(0)
  total        Int      @default(0)
  score        Int      @default(0) // в баллах (0..maxScore)
  startedAt    DateTime? // когда ученик начал (для тестов с ограничением по времени)
  finished     Boolean  @default(true) // false = попытка идёт прямо сейчас
  submittedAt  DateTime @default(now())

  @@unique([testId, studentId])
  @@index([studentId])
}

// Вопрос теста с вариантами ответов и правильным вариантом
// Назначение теста группе. date — день теста именно для этой группы
// (пусто = общая дата теста): группы проходят одну работу в разные дни.
model TestGroup {
  testId  String
  test    Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  groupId String
  group   Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  date    DateTime?

  @@id([testId, groupId])
  @@index([groupId])
}

model TestQuestion {
  id      String   @id @default(cuid())
  testId  String
  test    Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  order   Int      @default(0)
  text    String
  options String[] // варианты ответов
  correct Int      @default(0) // индекс правильного варианта (0-based)
  // Исходник в LaTeX (если вопрос импортирован). text/options остаются читаемым
  // текстом — он нужен для списков, аналитики и как запасной вариант, если формула
  // не разберётся. Пусто = обычный текстовый вопрос, набранный руками.
  textTex    String?
  optionsTex String[] @default([])

  @@index([testId])
}

// Предметы (математика, физика ...) — базовая цена и доля в комбо-абонементе
model Subject {
  id        String             @id @default(cuid())
  name      String
  price     Int                @default(0) // базовая цена за месяц
  // Сколько занятий в месяц входит в цену: выборные — 12, обязательные — 8.
  // По этому числу делится платёж между предметами. 0 = не задано.
  lessonsPerMonth Int            @default(0)
  // Ставка преподавателя: сколько он получает с ОДНОГО ученика за teacherRateLessons
  // занятий. 0 = ставка не задана, зарплата считается по старой модели (доля ученика).
  teacherRate        Int         @default(0)
  teacherRateLessons Int         @default(12)
  // Ставка куратора: сколько он получает в месяц с ОДНОГО оплатившего ученика этого предмета.
  // 0 = берётся общая ставка из настроек (Settings.curatorRate).
  curatorRate        Int         @default(0)
  color     String             @default("#3A5AE0")
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  items     SubscriptionItem[]
  payItems  PaymentItem[]
  groups    Group[]
  teachers  Teacher[] // преподаватели этого предмета (many-to-many)
  tests     Test[]
}

// Абонементы
// УСТАРЕЛО (2026-10-13): абонементы больше не создаются и нигде не читаются.
// Цена со скидками выставляется счётом (Payment.months), зарплата идёт только от оплаченных счетов.
// Таблица оставлена как история; удалить отдельной миграцией, когда данные не понадобятся.
model Subscription {
  id           String             @id @default(cuid())
  studentId    String
  student      Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plan         String
  months       Int                @default(1)
  price        Int                @default(0) // итоговая цена после скидок (за весь срок)
  basePrice    Int                @default(0) // сумма базовых цен предметов до скидок
  discountName String? // название применённой спец-скидки
  discountPct  Int                @default(0) // спец-скидка, %
  multiPct     Int                @default(0) // скидка за несколько предметов, %
  promoCode    String? // применённый промокод (если был)
  startDate    DateTime           @default(now())
  endDate      DateTime?
  status       String             @default("ACTIVE")
  items        SubscriptionItem[]
}

// Промокод: разовая процентная скидка, применяется при оформлении абонемента
model PromoCode {
  id        String   @id @default(cuid())
  code      String   @unique
  percent   Int      @default(0) // размер скидки, %
  active    Boolean  @default(true)
  maxUses   Int      @default(0) // 0 = без ограничения
  usedCount Int      @default(0) // сколько раз применён
  expiresAt DateTime? // действует до этой даты включительно (пусто = бессрочно)
  note      String? // комментарий (напр. «реферал Ивановых»)
  createdAt DateTime @default(now())
}

// Позиция абонемента по предмету (доля предмета)
model SubscriptionItem {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subjectId      String?
  subject        Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectName    String // снимок названия на момент продажи
  base           Int          @default(0) // базовая доля до скидок (за весь срок)
  amount         Int          @default(0) // итог после скидок — доля предмета

  @@index([subscriptionId])
  @@index([subjectId])
}

// Расписание — слот занятия для группы
model Lesson {
  id         String          @id @default(cuid())
  groupId    String
  group      Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 1 = Пн ... 6 = Сб
  startTime  String // "16:00"
  // Занятие убрали из расписания, но у него есть история посещаемости.
  // Удалять нельзя — отметки пропали бы вместе с ним, поэтому прячем.
  archivedAt DateTime?
  // С какого дня слот действует (UTC-полночь). null — с начала группы.
  // Нужен, чтобы слот, добавленный при смене расписания, не попадал в прошлые месяцы.
  activeFrom DateTime?
  room       String          @default("Каб. 1")
  attendance Attendance[]
  sessions   LessonSession[]
  makeups    Makeup[]
}

// Отработка: занятие, пропущенное по уважительной причине, проводится в другой день.
// Когда отработка проведена, появляется отметка посещаемости на дату отработки —
// поэтому преподаватель получает за неё оплату, как за обычное занятие.
model Makeup {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId   String
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  missedDate DateTime // дата пропущенного занятия
  plannedAt  DateTime // на когда назначена отработка
  status     String   @default("PLANNED") // PLANNED | DONE | CANCELLED
  note       String?
  createdBy  String?
  createdAt  DateTime @default(now())

  @@unique([studentId, lessonId, missedDate])
  @@index([plannedAt])
  @@index([studentId])
}

// Проведённое занятие в конкретную дату: тема урока (журнал)
model LessonSession {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  date      DateTime // дата конкретного занятия
  topic     String   @default("") // тема урока («что проходили»)
  cancelled Boolean  @default(false) // занятие не состоялось (праздник, болезнь преподавателя)
  cancelReason String? // почему отменено
  cancelFault String? // TEACHER — по вине преподавателя (день остаётся в делителе зарплаты); SCHOOL/OTHER — нет
  materials Material[] // материалы, разобранные на этом занятии
  createdAt DateTime @default(now())

  @@unique([lessonId, date])
  @@index([lessonId])
}

// Посещаемость — отметка ученика на конкретную дату занятия
model Attendance {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime // дата конкретного занятия
  present   Boolean  @default(true)
  excused   Boolean  @default(false) // если отсутствовал: true = уважительная (учителю не платят за этот день)

  @@unique([lessonId, studentId, date])
  @@index([studentId]) // пересчёт % посещаемости ученика
  @@index([date]) // выборки за месяц: журнал, зарплата
}

// Лиды / воронка продаж
model Lead {
  id         String         @id @default(cuid())
  name       String // контакт (родитель)
  childName  String?
  phone      String?
  grade      String?
  subject    String?
  source     String? // Instagram, 2ГИС, Сайт, Рекомендация...
  stage      String         @default("NEW") // NEW | CONTACTED | TRIAL | INVOICED | WON | LOST
  note       String?
  trialDate    DateTime? // запланированный пробный урок
  nextActionAt DateTime? // дата следующего действия (перезвонить и т.п.)
  activities LeadActivity[]
  createdAt  DateTime       @default(now())
}

// Активности по лиду: звонок, задача, заметка
model LeadActivity {
  id        String    @id @default(cuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String    @default("NOTE") // CALL | TASK | NOTE
  text      String
  dueDate   DateTime?
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())
}

// Одноразовый токен для входа через бота Telegram
model LoginToken {
  token     String   @id
  userId    String? // вход подтверждён: заполняется, когда человек нажал в боте «Да, это я»
  // Нажали «Старт», но ещё не подтвердили. Без подтверждения чужая ссылка входа,
  // присланная админу под видом «подтвердите заявку», открыла бы его аккаунт.
  pendingUserId String?
  device    String? // с какого устройства начат вход — показывается в боте при подтверждении
  createdAt DateTime @default(now())
}

// Родителю уже напомнили, что по предмету заканчиваются оплаченные занятия.
// Ключ — сколько всего занятий оплачено (total): новая оплата меняет total,
// и следующее напоминание снова возможно. Без этого cron слал бы его каждый день.
model PackageNotice {
  id        String   @id @default(cuid())
  studentId String
  subjectId String
  total     Int
  sentAt    DateTime @default(now())

  @@unique([studentId, subjectId, total])
}

// Неудачные попытки входа по паролю: после 10 за 15 минут вход на этот email
// временно закрыт — подбор пароля перебором становится бессмысленным.
model LoginFailure {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// Настройки школы (единственная запись с id = "main")
model Settings {
  id         String   @id @default("main")
  schoolName String   @default("МатАкадемия")
  address    String   @default("г. Алматы, ул. Абая")
  branches   String   @default("Абая") // через запятую
  rooms      String   @default("Каб. 1, Каб. 2, Каб. 3") // через запятую
  tariffs    String   @default("[]") // JSON: [{plan, months, price}]
  tplOverdue String   @default("") // шаблон: долг
  tplPending String   @default("") // шаблон: ожидает оплаты
  tplExpiring String  @default("") // шаблон: заканчиваются оплаченные занятия (пакет)
  managerDenied String @default("") // запрещённые менеджеру модули (ключи через запятую)
  discounts     String @default("") // спец-скидки: "название | процент" построчно
  multiDiscount String @default("") // скидки за несколько предметов: "кол-во | процент" построчно
  discountMode  String @default("add") // как объединять скидки: add | max | mul
  siblingDiscount Int  @default(0) // скидка «брат/сестра», % (0 = выкл)
  schoolFeePct   Int   @default(3) // удержание школы из оплаты ученика перед начислением зарплаты, %
  curatorRate    Int   @default(1000) // зарплата куратора: ₸ в месяц с одного оплатившего ученика по предмету (если у предмета нет своей ставки)
  tzOffsetHours  Int   @default(5) // часовой пояс школы относительно UTC (Алматы = 5)
  defaultLocale  String @default("ru") // язык страниц для учеников и родителей: ru | kk
  notifyStudent  Boolean @default(false) // дублировать уведомления самому ученику в Telegram
  lessonDurationMin Int  @default(60) // длительность занятия, мин (для выгрузки в календарь)
  notifyGrade    Boolean @default(false) // авто-уведомление родителю о новой оценке
  notifyHomework Boolean @default(false) // авто-уведомление о новом ДЗ
  notifyCancel   Boolean @default(false) // авто-уведомление об отмене занятия
  notifyZachet   Boolean @default(false) // авто-уведомление о назначенном зачёте и его итоге
  tplGrade       String  @default("")
  tplHomework    String  @default("")
  tplCancel      String  @default("")
  tplZachet      String  @default("")
  tplZachetResult String @default("")
  updatedAt  DateTime @updatedAt
}

// Журнал изменений (аудит)
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String
  action    String // CREATE | UPDATE | DELETE
  entity    String // Ученик, Оплата, Лид, Группа, Абонемент, Занятие, Посещаемость
  label     String // имя/описание объекта
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity])
  @@index([userName])
}

// Оплаты
model Payment {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  purpose   String
  method    String?  // Kaspi, Халық банк, Карта, Наличные
  amount    Int // сумма счёта
  paidAmount     Int @default(0) // фактически принято (сумма приходов) — кэш из PaymentTx
  refundedAmount Int @default(0) // фактически возвращено — кэш из PaymentTx
  status    String   @default("PAID") // PAID | PARTIAL | PENDING | OVERDUE
  date      DateTime @default(now()) // месяц, за который выставлен счёт (первый, если месяцев несколько)
  // На сколько месяцев счёт: доля предмета в зарплате делится поровну между ними,
  // начиная с месяца date. Обычный счёт — 1.
  months    Int      @default(1)
  // Номер месяца обучения, с которого начинается счёт («1-й месяц»). Месяц обучения —
  // пакет занятий (12 или 8 по предмету), а не календарный месяц. null — старый счёт
  // за календарный месяц (date). См. lib/packages.ts.
  studyMonth Int?
  items     PaymentItem[]
  txs       PaymentTx[]

  @@index([studentId, status])
  @@index([status, date])
  @@index([date])
}

// Движение денег по счёту: приход или возврат, у каждого своя дата.
// Доход за период считается по этим записям, а не по дате счёта.
model PaymentTx {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  kind      String   @default("PAYMENT") // PAYMENT | REFUND
  amount    Int // всегда положительная
  method    String?
  date      DateTime @default(now())
  note      String?
  createdBy String?
  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([date])
}

// Разбивка платежа по предметам (пропорционально) — фактически собранный доход по предметам
model PaymentItem {
  id          String   @id @default(cuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectName String // снимок названия
  amount      Int      @default(0)
  // Снимок «занятий в месяце» предмета на момент счёта: цена занятия = amount ÷ (months × это).
  // Если потом поменять число занятий у предмета, старые счета не пересчитываются. null — берётся у предмета.
  lessonsPerMonth Int?

  @@index([paymentId])
  @@index([subjectId])
}

// Расходы школы (аренда, коммунальные, реклама…) — чтобы «Отчёты» показывали настоящую прибыль
model Expense {
  id        String   @id @default(cuid())
  category  String   @default("OTHER") // ключ из lib/expenses.ts: RENT, UTILITIES, ADS, OFFICE…
  title     String
  amount    Int
  date      DateTime @default(now())
  note      String?
  createdBy String?
  createdAt DateTime @default(now())
  recurring Boolean  @default(false) // ежемесячный (аренда, коммунальные): можно перенести в следующий месяц
  copiedFromId String? // перенесён из этого расхода прошлого месяца — чтобы не перенести дважды

  @@index([date])
}

// Зачёт: куратор назначает группе зачёт (тема, дата и время) и отмечает каждого
// ученика «сдал» / «не сдал». Результат видит родитель в своём портале и сам ученик.
model Zachet {
  id          String         @id @default(cuid())
  groupId     String
  group       Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  topic       String
  scheduledAt DateTime // момент начала (UTC); вводится по часам школы
  note        String?
  createdBy   String?
  createdAt   DateTime       @default(now())
  results     ZachetResult[]

  @@index([groupId, scheduledAt])
}

model ZachetResult {
  id        String   @id @default(cuid())
  zachetId  String
  zachet    Zachet   @relation(fields: [zachetId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  passed    Boolean // true — сдал, false — не сдал; нет записи — ещё не отмечен
  comment   String?
  markedBy  String?
  markedAt  DateTime @default(now())

  @@unique([zachetId, studentId])
  @@index([studentId])
}
